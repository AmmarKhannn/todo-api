@baseUrl = http://localhost:3000
@json = application/json
@todoId = {{createTodo.response.body.$.id}}

### 1 Create a todo (201) - RUN THIS FIRST
# @name createTodo
POST {{baseUrl}}/todos
Content-Type: {{json}}
Accept: {{json}}

{
  "title": "Write API documentation",
  "description": "OpenAPI + README examples",
  "state": "todo",
  "dueDate": "2027-01-15"
}

### 2 List todos (200)
GET {{baseUrl}}/todos
Accept: {{json}}

### 3 Filter todo (200)
GET {{baseUrl}}/todos?state=todo
Accept: {{json}}

### 4 Get the created todo (200)
GET {{baseUrl}}/todos/{{todoId}}
Accept: {{json}}

### 5 Update state only (200)
PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: {{json}}
Accept: {{json}}

{"state": "doing"}

### 6 Filter doing (200)
GET {{baseUrl}}/todos?state=doing
Accept: {{json}}

### 7 Update all editable fields (200)
PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: {{json}}
Accept: {{json}}

{
  "title": "Finish API assignment",
  "description": "Check all requests",
  "state": "done",
  "dueDate": "2027-01-16"
}

### 8 Filter done (200)
GET {{baseUrl}}/todos?state=done
Accept: {{json}}

### 9 Create with defaults (201)
# @name createDefault
POST {{baseUrl}}/todos
Content-Type: {{json}}
Accept: {{json}}

{"title": "Study REST APIs"}

### 10 Create doing (201)
POST {{baseUrl}}/todos
Content-Type: {{json}}
Accept: {{json}}

{"title": "Doing task", "state": "doing"}

### 11 Create done (201)
POST {{baseUrl}}/todos
Content-Type: {{json}}
Accept: {{json}}

{"title": "Done task", "state": "done"}

### 12 Trim title and accept an empty description (200)
PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: {{json}}
Accept: {{json}}

{"title": "  Finish assignment  ", "description": ""}

